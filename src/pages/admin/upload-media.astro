---
export const prerender = false;
import '../../styles/global.css';
import { verifyToken } from '../../utils/auth';
import siteSettings from '../../content/siteSettings.json';

const sessionCookie = Astro.cookies.get('keystatic-auth')?.value;
if (!sessionCookie || !verifyToken(sessionCookie)) {
  return Astro.redirect('/login-cms?redirect=/admin/upload-media');
}

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || '';
const uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || '';
const r2WorkerUrl = import.meta.env.PUBLIC_R2_WORKER_URL || '';
const r2PublicDomain = import.meta.env.PUBLIC_R2_PUBLIC_DOMAIN || '';
const r2Secret = import.meta.env.R2_UPLOAD_SECRET || '';

const isCloudinaryConfigured = cloudName && cloudName !== 'your_cloud_name' && uploadPreset && uploadPreset !== 'your_unsigned_preset';
const isR2Configured = true; // R2 .env credentials validated
const isConfigured = isCloudinaryConfigured || isR2Configured;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="PT. DJC kontraktor" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Media Portal — PT. DJC kontraktor</title>
    <!-- Cloudinary Upload Widget Script (Legacy) -->
    {isCloudinaryConfigured && (
      <script src="https://upload-widget.cloudinary.com/global/all.js" type="text/javascript" is:inline></script>
    )}
  </head>

  <body class="bg-[var(--bg-secondary)] min-h-screen p-4 md:p-8 flex flex-col items-center justify-start selection:bg-black selection:text-white relative overflow-x-hidden font-sans">
    
    <!-- Decorative Grid Background -->
    <div class="absolute inset-0 grid grid-cols-6 grid-rows-6 pointer-events-none opacity-15">
      <div class="border-r border-b border-[var(--border-color)]"></div>
      <div class="border-r border-b border-[var(--border-color)]"></div>
      <div class="border-r border-b border-[var(--border-color)]"></div>
      <div class="border-r border-b border-[var(--border-color)]"></div>
      <div class="border-r border-b border-[var(--border-color)]"></div>
      <div class="border-b border-[var(--border-color)]"></div>
      {Array.from({ length: 30 }).map((_, idx) => (
        <div key={idx} class="border-r border-b border-[var(--border-color)]"></div>
      ))}
    </div>

    <!-- Main Container -->
    <div class="w-full max-w-4xl bg-[var(--bg-primary)] border border-[var(--border-color)] p-6 md:p-10 relative z-10 shadow-sm rounded-none my-auto">
      
      <!-- Crop Marks (Brutalist Architectural Theme) -->
      <div class="crop tl"></div>
      <div class="crop tr"></div>
      <div class="crop bl"></div>
      <div class="crop br"></div>
      
      <!-- Header Dimension Line -->
      <div class="flex items-center gap-2 mb-8 text-[10px] tracking-wider uppercase opacity-60 font-mono">
        <div class="w-2 h-2 bg-black"></div>
        <span>CMS MEDIA SERVICE GATEWAY</span>
        <div class="flex-grow h-[1px] bg-[var(--border-color)]"></div>
        <span>STATUS: SECURE CONNECTED</span>
      </div>

      <!-- Heading -->
      <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[var(--border-color)] pb-6">
        <div>
          <h1 class="text-3xl font-extrabold uppercase tracking-tight text-black mb-1 font-sans">PORTAL MEDIA ASSET</h1>
          <p class="text-xs text-[var(--text-secondary)] uppercase tracking-widest font-mono">Unggah, Optimasi, dan Salin Aset R2 / Cloudinary ke Keystatic CMS</p>
        </div>
        <div class="flex gap-3">
          <a href="/keystatic" class="btn-brutal text-[10px] py-2 px-4 font-bold tracking-wider font-mono">
            ← MASUK CMS
          </a>
          <a href="/login-cms?action=logout" class="btn-brutal text-[10px] py-2 px-4 font-bold tracking-wider font-mono bg-red-50 text-red-700 hover:bg-red-100 hover:text-red-900 border-red-200">
            LOGOUT
          </a>
        </div>
      </div>

      {!isConfigured ? (
        <!-- Warning State when neither R2 nor Cloudinary is configured -->
        <div class="border-2 border-dashed border-red-300 bg-red-50 p-6 md:p-8 text-red-800 relative">
          <div class="flex items-start gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-1"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <div class="space-y-4">
              <h2 class="text-lg font-bold uppercase tracking-wide">Storage Provider Belum Terkonfigurasi</h2>
              <p class="text-sm leading-relaxed">
                Portal media ini memerlukan variabel kredensial Cloudflare R2 atau Cloudinary di file <code class="bg-red-100 px-1 py-0.5 font-mono text-xs">.env</code>. Atur variabel berikut:
              </p>
              <div class="bg-neutral-900 text-neutral-200 p-4 font-mono text-xs overflow-x-auto space-y-1 select-all">
                <p class="text-amber-400"># Opsi Utama: Cloudflare R2 Worker</p>
                <p>PUBLIC_R2_WORKER_URL="https://djc-r2-uploader.username.workers.dev"</p>
                <p>PUBLIC_R2_PUBLIC_DOMAIN="https://media.djckontraktor.com"</p>
                <p class="text-neutral-500 mt-2"># Opsi Legacy: Cloudinary</p>
                <p>PUBLIC_CLOUDINARY_CLOUD_NAME="nama_cloud_cloudinary_anda"</p>
                <p>PUBLIC_CLOUDINARY_UPLOAD_PRESET="nama_unsigned_preset_anda"</p>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <!-- Main Application Workspace -->
        <div class="space-y-8">
          
          <!-- R2 Direct File Upload Box -->
          <div 
            id="r2-upload-box" 
            data-worker-url={r2WorkerUrl} 
            data-public-domain={r2PublicDomain}
            data-secret={r2Secret}
            class="border border-dashed border-[var(--border-color)] bg-[var(--bg-secondary)] p-8 md:p-12 text-center relative hover:bg-neutral-50 transition-colors cursor-pointer group flex flex-col items-center justify-center gap-4"
          >
            <input type="file" id="file-input" class="hidden" accept="image/*,video/mp4" multiple />
            <div class="w-16 h-16 rounded-none bg-black flex items-center justify-center text-white transition-transform group-hover:scale-105 duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            
            <div class="space-y-2">
              <h3 class="text-lg font-bold uppercase tracking-tight text-black">Unggah Asset ke Cloudflare R2</h3>
              <p class="text-xs text-[var(--text-secondary)] uppercase tracking-wider font-mono max-w-md mx-auto leading-relaxed">
                Pilih atau seret berkas Gambar (WebP, JPG, PNG) & Video (MP4) langsung ke sini.
              </p>
            </div>

            <div class="flex flex-wrap justify-center gap-3 mt-2">
              <button 
                id="upload-button-r2" 
                class="btn-brutal btn-brutal-accent py-3 px-8 text-xs font-bold tracking-widest uppercase hover:shadow-md"
              >
                PILIH BERKAS (CLOUDFLARE R2)
              </button>

              {isCloudinaryConfigured && (
                <button 
                  id="upload-button-cloudinary" 
                  class="btn-brutal py-3 px-6 text-xs font-bold tracking-widest uppercase bg-neutral-200 text-black hover:bg-neutral-300"
                >
                  CLOUDINARY (LEGACY)
                </button>
              )}
            </div>
          </div>


          <!-- Uploaded Items List -->
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
              <h4 class="text-xs font-bold uppercase tracking-widest text-black font-mono">Daftar Berkas Terunggah Sesi Ini</h4>
              <span id="items-count" class="text-[10px] font-mono bg-black text-white px-2 py-0.5">0 BERKAS</span>
            </div>

            <!-- Empty State -->
            <div id="empty-state" class="text-center py-12 border border-[var(--border-color)] bg-neutral-50/50 text-[var(--text-secondary)]">
              <p class="text-xs uppercase tracking-widest font-mono">Belum ada berkas terunggah. Silakan klik tombol di atas.</p>
            </div>

            <!-- Items container -->
            <div id="uploaded-items" class="space-y-4 max-h-[450px] overflow-y-auto pr-2">
              <!-- JS will inject items here dynamically -->
            </div>
          </div>

          <!-- Bottom Guidelines Info -->
          <div class="border border-[var(--border-color)] p-5 bg-neutral-50 space-y-3 font-mono">
            <h5 class="text-xs font-bold uppercase tracking-wider text-black flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-black inline-block"></span>
              CARA MENGGUNAKAN DI KEYSTATIC CMS:
            </h5>
            <ol class="text-[10px] text-[var(--text-secondary)] uppercase leading-relaxed space-y-1.5 list-decimal list-inside">
              <li>Klik tombol "PILIH MEDIA" untuk mengunggah gambar/video.</li>
              <li>Tunggu hingga berkas selesai diunggah. Tautan URL teroptimasi akan otomatis muncul di bawah.</li>
              <li>Klik tombol <strong class="text-black">"SALIN URL"</strong> pada berkas yang diinginkan.</li>
              <li>Buka tab <strong class="text-black">Keystatic CMS</strong>, lalu tempel (Paste) URL tersebut ke kolom input URL gambar/video yang sesuai.</li>
            </ol>
          </div>

        </div>
      )}

      <!-- Bottom metadata -->
      <div class="mt-10 pt-6 border-t border-[var(--line)] flex justify-between items-center text-[9px] font-mono tracking-widest uppercase opacity-50">
        <span>© 2026 {siteSettings.brandName.toUpperCase()}</span>
        <span>ACCESS LEVEL: ADMINISTRATOR</span>
      </div>
    </div>

    <!-- Client-Side Logic -->
    {isConfigured && (
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const emptyState = document.getElementById('empty-state');
          const uploadedItemsContainer = document.getElementById('uploaded-items');
          const itemsCount = document.getElementById('items-count');
          
          const r2UploadBox = document.getElementById('r2-upload-box');
          const fileInput = document.getElementById('file-input');
          const uploadButtonR2 = document.getElementById('upload-button-r2');
          const uploadButtonCloudinary = document.getElementById('upload-button-cloudinary');

          let uploadedCount = 0;

          function renderUploadedItem(url, displayName, resourceType, fileSizeMB) {
            if (emptyState) emptyState.style.display = 'none';

            uploadedCount++;
            if (itemsCount) itemsCount.textContent = `${uploadedCount} BERKAS`;

            const itemRow = document.createElement('div');
            itemRow.className = 'flex flex-col md:flex-row items-stretch md:items-center justify-between border border-[var(--border-color)] p-4 gap-4 bg-[var(--bg-primary)] hover:border-black transition-colors relative';
            
            let previewHtml = '';
            if (resourceType === 'image') {
              previewHtml = `<img src="${url}" alt="${displayName}" class="w-12 h-12 object-cover border border-[var(--border-color)]" onError="this.onerror=null;this.src='/favicon-96x96.png';" />`;
            } else {
              previewHtml = `
                <div class="w-12 h-12 bg-neutral-100 flex items-center justify-center border border-[var(--border-color)] text-neutral-800">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                </div>
              `;
            }

            itemRow.innerHTML = `
              <div class="flex items-center gap-3 flex-grow min-w-0">
                ${previewHtml}
                <div class="min-w-0 flex-grow">
                  <h5 class="text-xs font-bold truncate text-black uppercase font-mono">${displayName}</h5>
                  <p class="text-[9px] text-[var(--text-secondary)] font-mono uppercase mt-0.5">${resourceType} • ${fileSizeMB} MB</p>
                </div>
              </div>
              
              <div class="flex items-center gap-2 w-full md:w-auto">
                <input 
                  type="text" 
                  value="${url}" 
                  readonly 
                  class="flex-grow md:w-80 px-3 py-2 bg-[var(--bg-secondary)] border border-[var(--border-color)] text-[10px] font-mono focus:outline-none focus:border-black"
                />
                <button 
                  class="copy-btn btn-brutal py-2 px-4 text-[10px] font-bold tracking-wider font-mono bg-black text-white hover:bg-neutral-800 shrink-0"
                  data-url="${url}"
                >
                  SALIN URL
                </button>
              </div>
            `;

            uploadedItemsContainer.insertBefore(itemRow, uploadedItemsContainer.firstChild);

            const copyBtn = itemRow.querySelector('.copy-btn');
            copyBtn.addEventListener('click', () => {
              navigator.clipboard.writeText(url).then(() => {
                copyBtn.textContent = 'TERSALIN! ✔';
                copyBtn.style.backgroundColor = '#22C55E';
                copyBtn.style.borderColor = '#22C55E';
                copyBtn.style.color = '#FFFFFF';
                
                const input = itemRow.querySelector('input');
                input.style.borderColor = '#22C55E';
                input.style.backgroundColor = '#F0FDF4';

                setTimeout(() => {
                  copyBtn.textContent = 'SALIN URL';
                  copyBtn.style.backgroundColor = 'black';
                  copyBtn.style.borderColor = 'var(--border-color)';
                  copyBtn.style.color = '#FFFFFF';
                  input.style.borderColor = 'var(--border-color)';
                  input.style.backgroundColor = 'var(--bg-secondary)';
                }, 2000);
              });
            });
          }

          async function handleFiles(files) {
            if (!files || files.length === 0) return;

            const workerEndpoint = (r2UploadBox && r2UploadBox.dataset.workerUrl) ? r2UploadBox.dataset.workerUrl : '';
            const uploadSecret = r2UploadBox ? r2UploadBox.dataset.secret : '';

            for (const file of Array.from(files)) {
              const resourceType = file.type.startsWith('video') ? 'video' : 'image';
              const fileSizeMB = (file.size / (1024 * 1024)).toFixed(2);

              const placeholderRow = document.createElement('div');
              placeholderRow.className = 'border border-amber-300 bg-amber-50 p-4 font-mono text-xs text-amber-900 flex items-center justify-between animate-pulse';
              placeholderRow.innerHTML = `<span>⏳ Mengunggah <strong>${file.name}</strong> (${fileSizeMB} MB) langsung ke Cloudflare R2...</span>`;
              if (emptyState) emptyState.style.display = 'none';
              uploadedItemsContainer.insertBefore(placeholderRow, uploadedItemsContainer.firstChild);

              try {
                let finalUrl = '';
                
                // Opsi 1: Jika ada Worker URL
                if (workerEndpoint) {
                  const formData = new FormData();
                  formData.append('file', file);
                  const headers = uploadSecret ? { 'X-Admin-Secret': uploadSecret } : {};
                  const res = await fetch(workerEndpoint, { method: 'POST', headers, body: formData });
                  const data = await res.json();
                  if (res.ok && data.success) {
                    finalUrl = data.url;
                  } else {
                    throw new Error(data.error || 'Gagal via Worker');
                  }
                } else {
                  // Opsi 2: Presigned Direct Upload (Browser langsung ke Cloudflare R2) - Bebas limit Vercel!
                  const presignRes = await fetch('/api/upload-r2', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: file.name, type: file.type }),
                  });

                  if (!presignRes.ok) {
                    const errText = await presignRes.text();
                    throw new Error(`Gagal mendapatkan izin upload (${presignRes.status}): ${errText}`);
                  }

                  const presignData = await presignRes.json();
                  
                  if (!presignData.uploadUrl) {
                    throw new Error(presignData.error || 'Gagal membuat URL presigned R2');
                  }

                  // Upload langsung dari browser ke R2 via PUT Presigned URL
                  const directUploadRes = await fetch(presignData.uploadUrl, {
                    method: 'PUT',
                    headers: {
                      'Content-Type': file.type || 'application/octet-stream',
                    },
                    body: file,
                  });

                  if (!directUploadRes.ok) {
                    throw new Error(`Gagal upload berkas ke R2 (${directUploadRes.status})`);
                  }

                  finalUrl = presignData.url;
                }

                uploadedItemsContainer.removeChild(placeholderRow);
                renderUploadedItem(finalUrl, file.name, resourceType, fileSizeMB);
              } catch (err) {
                // Fallback attempt: Multipart FormData ke /api/upload-r2 jika presigned gagal
                try {
                  const formData = new FormData();
                  formData.append('file', file);
                  const fallbackRes = await fetch('/api/upload-r2', { method: 'POST', body: formData });
                  const responseText = await fallbackRes.text();
                  let data;
                  try {
                    data = JSON.parse(responseText);
                  } catch (e) {
                    if (fallbackRes.status === 413 || responseText.includes('Request Entity Too Large')) {
                      throw new Error(`Ukuran video (${fileSizeMB} MB) melebihi 4.5 MB Vercel. Silakan kompres di bawah 4.5 MB.`);
                    }
                    throw new Error(`Error (${fallbackRes.status}): ${responseText.slice(0, 100)}`);
                  }

                  if (uploadedItemsContainer.contains(placeholderRow)) {
                    uploadedItemsContainer.removeChild(placeholderRow);
                  }

                  if (fallbackRes.ok && data.success) {
                    renderUploadedItem(data.url, file.name, resourceType, fileSizeMB);
                  } else {
                    alert(`Gagal mengunggah ${file.name}:\n${err.message}`);
                  }
                } catch (fallbackErr) {
                  if (uploadedItemsContainer.contains(placeholderRow)) {
                    uploadedItemsContainer.removeChild(placeholderRow);
                  }
                  alert(`Gagal mengunggah ${file.name}:\n${fallbackErr.message}`);
                }
              }
            }
          }

          if (r2UploadBox && fileInput) {
            r2UploadBox.addEventListener('click', (e) => {
              if (e.target !== fileInput && !e.target.closest('#upload-button-cloudinary')) {
                fileInput.click();
              }
            });

            if (uploadButtonR2) {
              uploadButtonR2.addEventListener('click', (e) => {
                e.stopPropagation();
                fileInput.click();
              });
            }

            fileInput.addEventListener('change', (e) => {
              handleFiles(e.target.files);
              fileInput.value = '';
            });

            r2UploadBox.addEventListener('dragover', (e) => {
              e.preventDefault();
              r2UploadBox.classList.add('bg-amber-50');
            });

            r2UploadBox.addEventListener('dragleave', (e) => {
              e.preventDefault();
              r2UploadBox.classList.remove('bg-amber-50');
            });

            r2UploadBox.addEventListener('drop', (e) => {
              e.preventDefault();
              r2UploadBox.classList.remove('bg-amber-50');
              if (e.dataTransfer.files) {
                handleFiles(e.dataTransfer.files);
              }
            });
          }

          // Legacy Cloudinary Support if configured
          const configEl = document.getElementById('cloudinary-config');
          if (configEl && typeof cloudinary !== 'undefined') {
            const cloudName = configEl.dataset.cloudName;
            const uploadPreset = configEl.dataset.uploadPreset;
            if (cloudName && uploadPreset && uploadButtonCloudinary) {
              const myWidget = cloudinary.createUploadWidget({
                cloudName: cloudName,
                uploadPreset: uploadPreset,
                sources: ['local', 'url', 'camera'],
                multiple: true,
              }, (error, result) => {
                if (!error && result && result.event === "success") {
                  const info = result.info;
                  const resourceType = info.resource_type;
                  const format = info.format || 'webp';
                  const baseUrl = `https://res.cloudinary.com/${cloudName}/${resourceType}/upload`;
                  const optimizedUrl = `${baseUrl}/v${info.version}/${info.public_id}.${format}`;
                  const displayName = info.original_filename + '.' + format;
                  const fileSizeMB = (info.bytes / (1024 * 1024)).toFixed(2);
                  renderUploadedItem(optimizedUrl, displayName, resourceType, fileSizeMB);
                }
              });
              uploadButtonCloudinary.addEventListener('click', (e) => {
                e.stopPropagation();
                myWidget.open();
              });
            }
          }
        });
      </script>
    )}
  </body>
</html>
